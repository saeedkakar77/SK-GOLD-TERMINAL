obRequireFvg         = input.bool(true, "Require FVG (True Valid OB Only)", group = GRP_OB, tooltip = "Sirf unhi candles ko mark karega jinhone Fair Value Gap (FVG) ke sath impulse start kiya ho.")

deleteObOnBreakClose = input.bool(true, "Auto-Delete OB on Candle Close Break", group = GRP_OB, tooltip = "Agar candle close Order Block ke bahar ho jaye to use chart se delete kar dega.")

showObLabels         = input.bool(true, "Show OB Center Labels", group = GRP_OB)

obLabelSize          = input.string("Small", "OB Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = GRP_OB)

extendObToMarket     = input.bool(true, "Extend Untested OBs to Live Bar", group = GRP_OB)

obLineWidth          = input.int(1, "OB Line Width", minval = 1, maxval = 3, group = GRP_OB)

maxObHistory         = input.int(20, "Max Active OBs on Chart", minval = 2, maxval = 50, group = GRP_OB)



